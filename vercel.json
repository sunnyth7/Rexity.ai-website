{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/LevelKraft-TELC%20Prep%20AI/Privacypolicy",
      "destination": "/levelkraft-telc-prep-ai/privacypolicy",
      "permanent": true
    },
    {
      "source": "/LevelKraft-TELC Prep AI/Privacypolicy",
      "destination": "/levelkraft-telc-prep-ai/privacypolicy",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:html))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}

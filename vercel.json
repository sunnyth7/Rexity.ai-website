{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["fra1"],
  "redirects": [
    {
      "source": "/rexity-omi",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/LevelKraft-TELC%20Prep%20AI/Privacypolicy",
      "destination": "/levelkraft-telc-prep-ai/privacypolicy",
      "permanent": true
    },
    {
      "source": "/LevelKraft-TELC Prep AI/Privacypolicy",
      "destination": "/levelkraft-telc-prep-ai/privacypolicy",
      "permanent": true
    },
    {
      "source": "/web/web-development",
      "destination": "/web/web-design",
      "permanent": true
    },
    {
      "source": "/marketing/video",
      "destination": "/marketing",
      "permanent": true
    },
    {
      "source": "/marketing/content",
      "destination": "/marketing/seo",
      "permanent": true
    },
    {
      "source": "/web/dashboards",
      "destination": "/web/saas",
      "permanent": true
    },
    {
      "source": "/testing-support",
      "destination": "/website-wartung",
      "permanent": true
    },
    {
      "source": "/website-fuer-handwerker",
      "destination": "/website-f%C3%BCr-handwerker",
      "permanent": true
    },
    {
      "source": "/systems/automation",
      "destination": "/automation",
      "permanent": true
    },
    {
      "source": "/systems/design",
      "destination": "/web/web-design",
      "permanent": true
    },
    {
      "source": "/systems/development",
      "destination": "/web",
      "permanent": true
    },
    {
      "source": "/systems/scale",
      "destination": "/services",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; form-action 'self'; frame-src 'self' https://challenges.cloudflare.com"
        }
      ]
    },
    {
      "source": "/((?!api/check|api/mcp|mcp|openapi|\\.well-known/openapi).*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.rexity.ai"
        }
      ]
    },
    {
      "source": "/(openapi\\.json|\\.well-known/openapi\\.json)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(privacy|clevr/.*|save-and-fresh/.*|levelkraft-telc-prep-ai/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/rexity-omi/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:html))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/website-check/ergebnis/:site",
      "destination": "/api/check?card=:site"
    }
  ],
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/followup",
      "schedule": "30 7 * * *"
    }
  ],
  "functions": {
    "api/chat.js": { "maxDuration": 60 },
    "api/check.js": { "maxDuration": 90 },
    "api/mcp.js": { "maxDuration": 90 }
  }
}

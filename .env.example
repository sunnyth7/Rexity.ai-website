# Rexity.ai — server-side environment variables
# Copy to .env for local development (`vercel dev`). NEVER commit real values.
# All of these are SERVER-side only: they are read by the serverless functions
# in api/ and are never exposed to the browser bundle.

# ---- Azure OpenAI (EU data zone: Germany West Central, DataZoneStandard) ----
# The chatbot runs entirely on our own Azure OpenAI instance so prompts and
# completions stay inside the EU. Do not add a non-EU model provider.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Optional: embedding deployment on the same instance, enables semantic
# (vector) retrieval from the Supabase KbChunk store. If unset, the chatbot
# degrades to keyword retrieval — never to a non-EU embedding provider.
AZURE_OPENAI_EMBED_DEPLOYMENT=

# ---- Supabase (knowledge base + lead/booking persistence) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

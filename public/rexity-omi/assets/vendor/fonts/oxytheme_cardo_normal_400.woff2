<script id='script-65f1c4b599ace-js' type='text/javascript'>

  // Wait for the document to be fully loaded
  document.addEventListener("DOMContentLoaded", function() {
    // Function to swap the data-status attribute after 3 seconds
    function swapDataStatus() {
      var form = document.querySelector('form[data-status="sent"]'); // Find the form element
      if (form) {
        // Swap the data-status attribute value after 3 seconds
        setTimeout(function() {
          form.setAttribute('data-status', 'init');
        }, 3000);
      }
    }
    
    // Call the function initially
    swapDataStatus();
    
    // Watch for changes in the DOM using MutationObserver
    var observer = new MutationObserver(function(mutationsList) {
      // Check if the data-status="sent" attribute has been added
      mutationsList.forEach(function(mutation) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'data-status' && mutation.target.getAttribute('data-status') === 'sent') {
          // If data-status="sent" attribute added, call the function to swap it after 3 seconds
          swapDataStatus();
        }
      });
    });
    
    // Start observing changes in the DOM
    observer.observe(document.body, { attributes: true, subtree: true });
  });

</script>

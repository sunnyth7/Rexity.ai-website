<script id='script-65ccbf87834e4-js' type='text/javascript'>
jQuery(document).ready(function () {
  // Add hover event to each button in the resources menu
  jQuery('.wit-resources-dropdown .dropdown-links a').hover(
    function () {
      // Get the index of the hovered <a> element
      var index = jQuery(this).index();

      // Remove active class from previously hovered button and dropdown div
      jQuery('.wit-resources-dropdown .dropdown-links a.dropdown-link-active').removeClass('dropdown-link-active');
      jQuery('.wit-resources-dropdown .dropdown-divs > div.dropdown-div-active').removeClass('dropdown-div-active');

      // Add active class to current button
      jQuery(this).addClass('dropdown-link-active');

      // Set the opacity of the corresponding menu to 1 with a smooth transition
      jQuery('.wit-resources-dropdown .dropdown-divs > div').eq(index).addClass('dropdown-div-active');
    },
    function () {
      // You can add additional behavior on mouse out if needed
    }
  );

  // Hover in event for resources-menu-button
  jQuery('.resources-menu-button').mouseenter(function () {
    // Add the menu-open class to body
    jQuery('body').addClass('menu-open-resources');
  });

  // Hover out event for resources-menu-button
  jQuery('.resources-menu-button').mouseleave(function () {
    // Check if the mouse is still over .wit-resources-dropdown
    if (!jQuery('.wit-resources-dropdown').is(':hover')) {
      // Remove the menu-open class from body
      jQuery('body').removeClass('menu-open-resources');
    }
  });

  // Hover in and out events for .wit-resources-dropdown
  jQuery('.wit-resources-dropdown').hover(
    function () {
      // Add the menu-open class to body
      jQuery('body').addClass('menu-open-resources');
    },
    function () {
      // Remove the menu-open class from body
      jQuery('body').removeClass('menu-open-resources');
    }
  );
});

</script>
